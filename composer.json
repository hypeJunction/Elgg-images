{
    "name": "hypejunction/images",
    "type": "elgg-plugin",
    "description": "Pure-service API plugin for Elgg that handles image upload, manipulation, and thumbnail generation for any file-based entity",
    "keywords": [
        "elgg",
        "plugin",
        "image"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ismayil Khayredinov",
            "email": "ismayil.khayredinov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-intl": "*",
        "imagine/imagine": "^1.0",
        "elgg/elgg": "~7.0.0",
        "composer/installers": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "extra": {
        "elgg-plugin": {
            "id": "images"
        }
    },
    "homepage": "https://github.com/hypeJunction/Elgg-images",
    "version": "7.0.0"
}
