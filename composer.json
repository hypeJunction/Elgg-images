{
    "name": "hypejunction/images",
    "version": "4.0.0",
    "type": "elgg-plugin",
    "description": "Images API — image upload, manipulation, and thumbnail service",
    "homepage": "http://hypejunction.com",
    "keywords": [
        "elgg",
        "plugin",
        "image"
    ],
    "license": "GPL-2.0",
    "authors": [
        {
            "name": "Ismayil Khayredinov",
            "email": "info@hypejunction.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "imagine/imagine": "^1.0",
        "elgg/elgg": "^4.0",
        "composer/installers": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "extra": {
        "elgg-plugin": {
            "id": "images"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    }
