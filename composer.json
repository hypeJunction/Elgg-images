{
	"name": "hypejunction/images",
	"type": "elgg-plugin",
	"description": "Pure-service API plugin for Elgg that handles image upload, manipulation, and thumbnail generation for any file-based entity",
	"keywords": [
		"elgg",
		"plugin",
		"image"
	],
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Ismayil Khayredinov",
			"email": "info@hypejunction.com"
		}
	],
	"require": {
		"composer/installers": "^2.0",
		"php": ">=8.1",
		"elgg/elgg": "~6.1.0",
		"ext-intl": "*",
		"imagine/imagine": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true
		}
	},
	"extra": {
		"elgg-plugin": {
			"id": "images"
		}
	}
}
